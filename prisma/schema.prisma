datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model User {
  id               String   @id // Clerk user ID
  email            String   @unique
  displayName      String
  handle           String   @unique
  avatarUrl        String?
  subjects         String[]
  focusPreference  String?
  defaultAmbience  String?
  bio              String?
  instagram        String?
  twitter          String?
  github           String?
  bannerUrl        String?
  currentGrind     String?
  whatImBuilding   String?
  location         String?
  timezone         String?
  currentMood      String?
  favoriteMusic    String?
  deepWorkHours    String?
  setupDetails     String?
  programmingTools String[]
  activeGoals      String[]
  customLinks      String[]
  xp               Int      @default(0)
  lastActive       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  onboardingCompleted Boolean @default(false)
  roomsCreated     Room[]   @relation("RoomCreator")
  rooms            Room[]   @relation("RoomParticipants")
  savedRooms       Room[]   @relation("SavedRooms")
  roomStats        RoomStats[] @relation("UserRoomStats")
  goalItems        GoalItem[]  @relation("UserGoals")
  dailyActivities  DailyActivity[] @relation("UserActivity")
  sentMessages     DirectMessage[] @relation("SentMessages")
  receivedMessages DirectMessage[] @relation("ReceivedMessages")
  sentFriendRequests     Friendship[] @relation("SentFriendRequests")
  receivedFriendRequests Friendship[] @relation("ReceivedFriendRequests")
}

model Friendship {
  id          String   @id @default(uuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requester   User     @relation("SentFriendRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("ReceivedFriendRequests", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model GoalItem {
  id               String    @id @default(uuid())
  userId           String
  roomId           String?
  title            String
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  xpWeight         Int
  estimatedMinutes Int       @default(25)
  complexity       String    @default("MEDIUM")
  createdAt        DateTime  @default(now())
  user             User      @relation("UserGoals", fields: [userId], references: [id], onDelete: Cascade)
}

model DailyActivity {
  id             String   @id @default(uuid())
  userId         String
  date           DateTime
  minutesStudied Int      @default(0)
  xpGained       Int      @default(0)
  xpGoal         Int      @default(100)
  user           User     @relation("UserActivity", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Room {
  id                String   @id @default(uuid())
  slug              String   @unique
  name              String
  subject           String
  capacity          Int
  visibility        String   // PUBLIC, UNLISTED, PRIVATE
  vibe              String?
  lockOnJoin        Boolean  @default(false)
  defaultAmbience   String?
  password          String?
  allowMic          Boolean  @default(true)
  allowCam          Boolean  @default(true)
  isDefaultRoom     Boolean  @default(false)
  globalChatEnabled Boolean  @default(true)
  creatorId         String
  creator           User     @relation("RoomCreator", fields: [creatorId], references: [id])
  participants      User[]   @relation("RoomParticipants")
  savedBy           User[]   @relation("SavedRooms")
  stats             RoomStats[] @relation("RoomStats")
  temporary         Boolean  @default(false)
  isCurated         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RoomStats {
  id           String   @id @default(uuid())
  userId       String
  roomId       String
  totalMinutes Int      @default(0)
  user         User     @relation("UserRoomStats", fields: [userId], references: [id], onDelete: Cascade)
  room         Room     @relation("RoomStats", fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
}

model DirectMessage {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  content     String
  delivered   Boolean  @default(true)
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}
